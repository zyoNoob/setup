#!/usr/bin/env bash
# Quick runner for isolated Open WebUI instance using uvx
set -euo pipefail

# Default configuration
DEFAULT_BASE_DIR="${HOME}/workspace/local-ai/openwebui"
BASE_DIR="${OPENWEBUI_DIR:-$DEFAULT_BASE_DIR}"

HOST="${HOST:-0.0.0.0}"
PORT="${PORT:-8080}"
USE_CPU="${USE_CPU:-0}" # Default to 0 (CUDA GPU runtime)

usage() {
    cat <<EOF
Usage: $(basename "$0") [options]

Runs a self-contained, isolated Open WebUI instance via uvx.
All database files, uploaded media, chat history, and uv environments
remain strictly inside the dedicated directory.

Options:
  -p, --port <port>     Set server port (default: 8080 or \$PORT)
  -H, --host <host>     Set bind host (default: 0.0.0.0 or \$HOST)
  -d, --dir <path>      Custom base directory (default: ~/workspace/local-ai/openwebui)
      --gpu             Run with GPU/CUDA acceleration (default)
      --cpu             Force lightweight CPU-only PyTorch build
  -h, --help            Show this help message

Environment variables:
  PORT, HOST, OPENWEBUI_DIR, USE_CPU
EOF
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -p|--port)
            PORT="$2"
            shift 2
            ;;
        -H|--host)
            HOST="$2"
            shift 2
            ;;
        -d|--dir)
            BASE_DIR="$2"
            shift 2
            ;;
        --gpu)
            USE_CPU="0"
            shift
            ;;
        --cpu)
            USE_CPU="1"
            shift
            ;;
        -h|--help)
            usage
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage
            ;;
    esac
done

# Ensure required directories exist inside target directory
mkdir -p "${BASE_DIR}/data" "${BASE_DIR}/uv_cache" "${BASE_DIR}/tmp"

export DATA_DIR="${BASE_DIR}/data"
export UV_CACHE_DIR="${BASE_DIR}/uv_cache"
export TMPDIR="${BASE_DIR}/tmp"

# Keep WEBUI_SECRET_KEY inside DATA_DIR so it doesn't leak into current working directory
KEY_FILE="${DATA_DIR}/.webui_secret_key"
if [[ -z "${WEBUI_SECRET_KEY:-}" ]]; then
    if [[ ! -f "$KEY_FILE" ]]; then
        head -c 32 /dev/urandom | base64 > "$KEY_FILE"
        chmod 600 "$KEY_FILE"
    fi
    export WEBUI_SECRET_KEY="$(<"$KEY_FILE")"
fi

# Detect primary LAN IP for convenience
PRIMARY_IP=$(ip -4 addr show scope global 2>/dev/null | grep -oP 'inet \K[\d.]+' | head -n1 || echo "localhost")

# Set clean CORS_ALLOW_ORIGIN if not explicitly provided (suppresses wildcard warning and secures local + LAN)
if [[ -z "${CORS_ALLOW_ORIGIN:-}" ]]; then
    CORS_ALLOW_ORIGIN="http://localhost:${PORT};http://127.0.0.1:${PORT}"
    if [[ "$PRIMARY_IP" != "localhost" ]]; then
        CORS_ALLOW_ORIGIN="${CORS_ALLOW_ORIGIN};http://${PRIMARY_IP}:${PORT}"
    fi
    export CORS_ALLOW_ORIGIN
fi

echo "================================================="
echo " Isolated Open WebUI"
echo " Location:    ${BASE_DIR}"
echo " Data Dir:    ${DATA_DIR}"
echo " UV Cache:    ${UV_CACHE_DIR}"
echo " Local URL:   http://localhost:${PORT}"
if [[ "$HOST" == "0.0.0.0" && "$PRIMARY_IP" != "localhost" ]]; then
    echo " LAN URL:     http://${PRIMARY_IP}:${PORT}"
fi
echo " Torch Mode:  $([ "$USE_CPU" = "1" ] && echo "CPU (lightweight, no CUDA bloat)" || echo "CUDA (NVIDIA runtime)")"
echo "================================================="

EXTRA_ARGS=()
if [[ "$USE_CPU" == "1" ]]; then
    # Direct uv to prefer CPU torch wheels, avoiding multi-GB CUDA downloads
    EXTRA_ARGS+=(--index https://download.pytorch.org/whl/cpu --default-index https://pypi.org/simple)
fi

exec uvx \
    --python 3.11 \
    "${EXTRA_ARGS[@]}" \
    open-webui serve \
    --host "${HOST}" \
    --port "${PORT}"
